    "Every story takes you somewhere new — from dark city streets to ancient kingdoms and forgotten worlds." : {
      "comment" : "Text describing the different worlds available in the stories.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jede Geschichte führt dich an einen neuen Ort — von dunklen Stadtstraßen über alte Königreiche bis hin zu vergessenen Welten."
          }
        }
      }
    },
    "Explore different stories filled with mystery, fantasy, battles and unexpected encounters." : {
